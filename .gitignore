# Godot 4.7: generated caches and import artifacts (also in nested projects).
# Keep project.godot, export_presets.cfg, *.uid and asset *.import sidecars.
# Reference: https://docs.godotengine.org/en/stable/tutorials/best_practices/version_control_systems.html
.godot/
.import/
.nomedia
~*.dll

# Generated binary translations; keep their CSV/PO sources.
*.translation

# Local export credentials and legacy Godot export configuration.
export_credentials.cfg
export.cfg

# Export builds into these root directories (or outside the project).
# Do not ignore ZIP/PCK/binary files globally: they can be source dependencies.
/build/
/builds/
/dist/
/exports/

# Generated Android build template; keep android/plugins/ versioned.
/android/build/

# Screenshots generated by scenarios/boot_check.json and game_win_flow.json.
/art/screenshots/

# Local Python tooling caches and virtual environments.
__pycache__/
*.py[cod]
.venv/

# Temporary editor files and backups.
*.tmp
*.temp
*.swp
*.swo
*~

# Operating system metadata.
.DS_Store
._*
Thumbs.db
ehthumbs.db
Desktop.ini
