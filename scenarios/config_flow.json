{
  "name": "Open configuration and toggle sound effects",
  "scene_path": "scenes/main.tscn",
  "viewport_size": {"width": 1280, "height": 720},
  "settle_frames": 4,
  "steps": [
    {"type": "wait_until", "node_path": "Background/ScreenFrame/ScreenStack/HomeScreen", "property": "visible", "expected": true},
    {"type": "wait_until", "node_path": "LoadingOverlay", "property": "visible", "expected": false},
    {"type": "mouse_button", "button_index": 1, "position": {"x": 748, "y": 654}, "pressed": true},
    {"type": "mouse_button", "button_index": 1, "position": {"x": 748, "y": 654}, "pressed": false},
    {"type": "wait_until", "node_path": "ModalOverlay/DialogCenter/Dialog/DialogBody/DialogTitle", "property": "text", "expected": "CONFIGURACIÓN"},
    {"type": "assert", "assertion": "node_exists", "node_path": "ModalOverlay/DialogCenter/Dialog/DialogBody/ConfigGrid/SfxToggle"},
    {"type": "assert", "assertion": "node_exists", "node_path": "ModalOverlay/DialogCenter/Dialog/DialogBody/ConfigGrid/MusicToggle"},
    {"type": "ui_report", "label": "configuration", "node_path": "ModalOverlay/DialogCenter/Dialog", "fail_on": ["any"]},
    {"type": "mouse_button", "button_index": 1, "position": {"x": 584, "y": 290}, "pressed": true},
    {"type": "mouse_button", "button_index": 1, "position": {"x": 584, "y": 290}, "pressed": false},
    {"type": "wait_until", "node_path": "ModalOverlay/DialogCenter/Dialog/DialogBody/ConfigGrid/SfxToggle", "property": "text", "expected": "SILENCIADOS"}
  ]
}
