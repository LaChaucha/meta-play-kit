{
  "name": "Pause and resume the playable level",
  "scene_path": "demo/scenes/main.tscn",
  "viewport_size": {"width": 1280, "height": 720},
  "settle_frames": 4,
  "steps": [
    {"type": "wait_until", "node_path": "Background/ScreenFrame/ScreenStack/HomeScreen", "property": "visible", "expected": true},
    {"type": "wait_until", "node_path": "LoadingOverlay", "property": "visible", "expected": false},
    {"type": "mouse_button", "button_index": 1, "position": {"x": 640, "y": 432}, "pressed": true},
    {"type": "mouse_button", "button_index": 1, "position": {"x": 640, "y": 432}, "pressed": false},
    {"type": "wait_until", "node_path": "Background/ScreenFrame/ScreenStack/GameScreen", "property": "visible", "expected": true},
    {"type": "mouse_button", "button_index": 1, "position": {"x": 113, "y": 57}, "pressed": true},
    {"type": "mouse_button", "button_index": 1, "position": {"x": 113, "y": 57}, "pressed": false},
    {"type": "wait_until", "node_path": "ModalOverlay/DialogCenter/Dialog/DialogBody/DialogTitle", "property": "text", "expected": "PAUSA"},
    {"type": "assert", "assertion": "node_exists", "node_path": "ModalOverlay/DialogCenter/Dialog/DialogBody/ResumeButton"},
    {"type": "ui_report", "label": "pause-dialog", "node_path": "ModalOverlay/DialogCenter/Dialog", "fail_on": ["any"]},
    {"type": "mouse_button", "button_index": 1, "position": {"x": 640, "y": 390}, "pressed": true},
    {"type": "mouse_button", "button_index": 1, "position": {"x": 640, "y": 390}, "pressed": false},
    {"type": "wait_until", "node_path": "ModalOverlay", "property": "visible", "expected": false}
  ]
}
