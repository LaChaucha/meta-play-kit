{
  "scene_path": "demo/scenes/main.tscn",
  "viewport_size": {
	"width": 1280,
	"height": 720
  },
  "settle_frames": 4,
  "steps": [
	{
	  "type": "wait_until",
	  "node_path": "Background/ScreenFrame/ScreenStack/HomeScreen",
	  "property": "visible",
	  "expected": true,
	  "timeout_seconds": 3.0
	},
	{
	  "type": "wait_until",
	  "node_path": "LoadingOverlay",
	  "property": "visible",
	  "expected": false,
	  "timeout_seconds": 3.0
	},
	{
	  "type": "dump_tree",
	  "label": "home-tree",
	  "properties": ["visible", "position", "size", "text"],
	  "max_depth": 8
	},
	{
	  "type": "ui_report",
	  "label": "home",
	  "ascii": true,
	  "fail_on": [
        "any"
	  ]
	},
	{
	  "type": "screenshot",
	  "path": "res://demo/screenshots/home.png",
	  "expect": {
		"not_blank": true,
		"min_opaque_ratio": 0.95
	  }
	}
  ]
}
